# Local-only placeholders for docker-compose.automation-dev.yml
# Copy: cp .env.automation-dev.example .env.automation-dev
# Never commit real passwords or tokens.

WINDMILL_DB_NAME=windmill
WINDMILL_DB_USER=windmill
WINDMILL_DB_PASSWORD=replace-with-local-windmill-db-password
WINDMILL_BASE_URL=http://127.0.0.1:8000
# After first UI login (default CE bootstrap user), change the password immediately.
# Create a scoped workspace token in the UI for wmill CLI — do not commit it.
# WINDMILL_DEV_TOKEN=
# Flask → Windmill outbound trigger (opt-in; keep unset/off against shared envs)
# FIKIRI_WINDMILL_TRIGGER_ENABLED=0
# WINDMILL_WORKSPACE=fikiri-dev
# WINDMILL_NORMALIZE_SCRIPT_PATH=f/normalize_leads/normalize_leads
