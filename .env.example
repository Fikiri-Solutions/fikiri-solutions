# Fikiri Solutions — environment placeholders (no real secrets)
# =============================================================================
# Copy to .env for local development:
#   cp .env.example .env
# Full variable reference: env.template
# Frontend-only vars: frontend/env.example → frontend/.env.local
#
# NEVER commit .env, paste it into chat/CI logs, or store secrets in tracked files.
# Set production values in Render / Vercel / your secret manager only.

FLASK_ENV=development
PORT=5000
# Bind address for `python app.py` (default loopback). Set FIKIRI_BIND_LAN=1 for 0.0.0.0.
# FLASK_BIND_HOST=127.0.0.1
# FIKIRI_BIND_LAN=0
# Legacy CREATE/ALTER/index bootstrap on PostgreSQL (off by default; use numbered migrations).
# FIKIRI_ALLOW_SCHEMA_BOOTSTRAP=0
# Slack performance-alert cooldown seconds (dedupe similar messages)
# FIKIRI_SLACK_ALERT_COOLDOWN_SECONDS=120

# Local SQLite (comment DATABASE_URL in .env to use data/fikiri.db)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@....pooler.supabase.com:5432/postgres?sslmode=require

REDIS_URL=redis://localhost:6379/0

# Auth / encryption (generate fresh values — do not reuse examples)
JWT_SECRET_KEY=your-jwt-secret-min-32-chars
FERNET_KEY=your-fernet-key-32-bytes-base64
SECRET_KEY=your-flask-secret-key

# Platform operators (ADMIN_USER_IDS) — /admin portal is a privileged system.
# Security standard: docs/ADMIN_PORTAL_SECURITY.md (Phase 1.5 gates destructive controls).
ADMIN_USER_IDS=1
# Impersonation kill switch (safe default: disabled when unset)
IMPERSONATION_ENABLED=false
# Step-up / MFA / session windows
ADMIN_STEP_UP_TTL_SECONDS=600
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_VERIFIER_ENABLED=false
ADMIN_SECURITY_STORE=memory
# ADMIN_MFA_CHALLENGE_TTL_SECONDS=300
# ADMIN_TOTP_ENROLLMENT_TTL_SECONDS=600
ADMIN_IDLE_TIMEOUT_SECONDS=1800
ADMIN_ABSOLUTE_SESSION_SECONDS=28800
# ADMIN_LOCKDOWN=1
# ADMIN_DESTRUCTIVE_ENABLED=false
# IMPERSONATION_TOKEN_EXPIRY_SECONDS=1800

# Product / customer-success analytics (default OFF)
# PRODUCT_ANALYTICS_ENABLED=false
# PRODUCT_ANALYTICS_ACCESSIBILITY_SIGNALS_ENABLED=false
# PRODUCT_ANALYTICS_RAW_RETENTION_DAYS=90
# PRODUCT_ANALYTICS_AGGREGATE_RETENTION_DAYS=395
# Optional comma-separated tenant IDs; empty = all tenants when enabled
# PRODUCT_ANALYTICS_TENANT_ALLOWLIST=

# AI
OPENAI_API_KEY=your-openai-api-key

# Billing
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Database / Supabase (Postgres URI is DATABASE_URL; REST client is separate)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key

# Email
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password

# OAuth (examples — see env.template for all providers)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# Integrations
PINECONE_API_KEY=your-pinecone-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
NOTION_API_KEY=your-notion-api-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# CORS (required in production for marketing-site widget)
CORS_ORIGINS=http://localhost:5174,http://localhost:3000,https://fikirisolutions.com,https://www.fikirisolutions.com

# =============================================================================
# Fikiri marketing site bot (backend — /api/site/chat/*, no tenant API key)
# Frontend widget: frontend/env.example → frontend/.env.local (VITE_* only)
# =============================================================================
FIKIRI_SITE_BOT_ENABLED=true
# Local/tests: 1. Production Render: omit or 0.
FIKIRI_SITE_BOT_TEST_MODE=1
# Soft launch: 0. Sales-review (staff transcript API): 1
FIKIRI_SITE_BOT_PERSIST_TRANSCRIPTS=0
FIKIRI_SITE_BOT_SESSION_TTL_SECONDS=86400
FIKIRI_SITE_BOT_RATE_LIMIT_PER_MINUTE=20
FIKIRI_SITE_BOT_RATE_LIMIT_BURST=40
FIKIRI_SITE_BOT_TRANSCRIPT_RETENTION_DAYS=90
# Set a strong random secret in production when FIKIRI_SITE_BOT_PERSIST_TRANSCRIPTS=1
FIKIRI_SITE_BOT_TRANSCRIPT_HASH_SALT=your-strong-random-salt

# =============================================================================
# Windmill CE automation pilot (opt-in; internal Fikiri use only)
# Compose: docker-compose.automation-dev.yml + .env.automation-dev.example
# Ingress auth reuses X-API-Key with exact scope automation:ingress (no new
# shared-secret auth subsystem). Apply scripts/migrations/008_*.sql first.
# =============================================================================
# WINDMILL_DB_PASSWORD=  (see .env.automation-dev.example — never commit)
# WINDMILL_DEV_TOKEN=    (workspace CLI token from local Windmill UI — never commit)
# FIKIRI_WINDMILL_TRIGGER_ENABLED=0
# WINDMILL_WORKSPACE=fikiri-dev
# WINDMILL_NORMALIZE_SCRIPT_PATH=f/normalize_leads/normalize_leads
# WINDMILL_BASE_URL=http://127.0.0.1:8000
